# AskAny reads environment variables using the field names in askany/config.py.
# Copy this file to .env, then uncomment only values that should differ from
# the code defaults. Uncommented assignments override askany/config.py.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Application defaults: localhost:5432, user wufei, password 123456,
# database askany. Leave these unset to use those defaults.
#
# If you use docker-compose.dev.yml, uncomment this block so the app matches
# the compose credentials:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=root
# POSTGRES_PASSWORD=123456
# POSTGRES_DB=askany
#
# For a host PostgreSQL user that is not the application default, uncomment
# and edit:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=wufei
# POSTGRES_PASSWORD=123456
# POSTGRES_DB=askany

# ── API / LLM (OpenAI-compatible) ────────────────────────────────────────────
# Defaults target a local vLLM endpoint and the model path in askany/config.py.
# OPENAI_API_BASE=http://127.0.0.1:8081/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ── Embedding ────────────────────────────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_MODEL_TYPE=sentence_transformer
# EMBEDDING_LOCAL_FILES_ONLY=false
# VECTOR_DIMENSION=1024

# ── Reranker ─────────────────────────────────────────────────────────────────
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_TYPE=sentence_transformer
# RERANKER_LOCAL_FILES_ONLY=false

# ── API server ───────────────────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=DEBUG

# ── Retrieval / agent behavior ──────────────────────────────────────────────
# ENABLE_WEB_SEARCH=true
# WEB_SEARCH_API_URL=http://localhost:8800/search
# USING_DOCS_KEYWORD_INDEX=false
# USING_CUSTOM_KEYWORD_INDEX=true
# KEYWORD_EXTRACTOR_PRIORITY=tfidf
# QUERY_REWRITE_BOOL=true
# AGENT_MAX_ITERATIONS=3

# ── QA semantic cache ────────────────────────────────────────────────────────
# ENABLE_QA_CACHE=true
# QA_CACHE_SIMILARITY_THRESHOLD=0.90

# ── LightRAG (optional package; separate ingestion CLI) ──────────────────────
# ENABLE_LIGHTRAG=true
# LIGHTRAG_QUERY_MODE=mix
# LIGHTRAG_WORKING_DIR=lightrag_data
# LIGHTRAG_API_BASE=
# LIGHTRAG_API_KEY=
# LIGHTRAG_LLM_MODEL=
# LIGHTRAG_EMBEDDING_MODEL=
# LIGHTRAG_EMBEDDING_DIM=1024

# ── Mem0 user memory (optional) ───────────────────────────────────────────────
# ENABLE_MEM0=false
# MEM0_COLLECTION_NAME=askany_mem0
# MEM0_TOP_K=5
# MEM0_SCORE_THRESHOLD=0.3

# ── Langfuse tracing (optional; install uv sync --extra observability) ────────
# ENABLE_LANGFUSE=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_RELEASE=
# LANGFUSE_DEBUG=false

# ── RAGAS evaluation (optional; install uv sync --extra observability) ────────
# ENABLE_RAGAS=false
# RAGAS_SAMPLE_RATE=1.0
# RAGAS_METRICS=["faithfulness", "response_relevancy", "context_precision"]
# RAGAS_EVAL_LLM_MODEL=
# RAGAS_EVAL_LLM_API_BASE=
# RAGAS_EVAL_LLM_API_KEY=

# ── HanLP / local model paths (optional) ──────────────────────────────────────
# HANLP_HOME=
# HANLP_TOKENIZER_PATH=
